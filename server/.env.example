# انسخ الملف ده وسمّيه .env، وحط فيه بياناتك الحقيقية (الملف .env ميترفعش على Git أبداً)

# ===== قاعدة البيانات =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=reda
DB_PASSWORD=mysql.ui
DB_NAME=abdelnabi_pctech

# ===== السيرفر =====
PORT=5000
# رابط الفرونت المسموح له بالاتصال بالـ API (CORS) — غيّره لرابط موقعك الحقيقي وقت الرفع
CLIENT_ORIGIN=http://localhost:5000

# ===== المصادقة (JWT) =====
# مفتاح سري لتوقيع التوكن — لازم يكون طويل وعشوائي وسري تمامًا، غيّره قبل الرفع فعليًا
# تقدر تولّد واحد عشوائي بالأمر: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ضع_مفتاح_عشوائي_طويل_وسري_هنا
# مدة صلاحية التوكن قبل ما يبقى محتاج تسجيل دخول تاني
JWT_EXPIRES_IN=7d
