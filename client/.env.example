# انسخ الملف ده وسمّيه .env، وحط فيه رابط الباك اند بتاعك (الملف .env ميترفعش على Git)
#
# ملحوظة: في التطبيق المدموج (بعد "npm run build" من المجلد الرئيسي)، الفرونت
# والباك اند بيبقوا على نفس الدومين، فمش محتاج الملف ده خالص (هيستخدم "/api"
# تلقائيًا). الملف ده يفيدك بس لو شغّلت الفرونت والباك اند منفصلين وقت التطوير
# (يعني npm run dev:client و npm run dev:server كل واحد في Terminal لوحده)

# رابط الـ API — أثناء التطوير المحلي المنفصل بيبقى السيرفر شغال على البورت ده افتراضياً
VITE_API_URL=http://localhost:5000/api
